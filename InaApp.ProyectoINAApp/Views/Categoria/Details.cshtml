@using InaApp.ProyectoINAApp.Models.Categoria


@model CategoriaIndexViewModel
@{
    ViewData["Title"] = "Detalles de Categoria";
}

<div class="container mt-4">

    <h2>Detalles de la Categoría</h2>

    <div class="card">
        <div class="card-header bg-light-subtle text-black">
            Vista de detalles de la categoría
        </div>

        <div class="card-body">
            <p><strong>Id:</strong> @Model.Id</p>
            <p><strong>Nombre:</strong> @Model.Nombre</p>
        </div>
    </div>

    <form asp-action="Index" method="post" class="mt-3">
        <input type="hidden" name="id" value="@Model.Id" />

        <a asp-action="Index" class="btn btn-secondary">
            Volver
        </a>
    </form>

</div>