@using inaApp.DTOs.Cliente
@model List<ClienteResponseDTO>

<div class="modal-header">
    <h5 class="modal-title">Seleccionar Cliente</h5>
    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
</div>
<div class="modal-body">
    <div class="mb-3">
        <div class="input-group">
            <span class="input-group-text"><i class="bi bi-search"></i></span>
            <input type="text" id="buscarClienteInput" class="form-control" placeholder="Buscar por ID o nombre del cliente..." />
        </div>
    </div>

    <div class="table-responsive">
        <table class="table table-bordered table-striped table-hover">
            <thead class="table-dark">
                <tr>
                    <th>Id</th>
                    <th>Nombre</th>
                    <th>Cédula</th>
                    <th>Teléfono</th>
                    <th>Correo</th>
                    <th class="text-center">Acción</th>
                </tr>
            </thead>
            <tbody id="tablaClientesBody">
                @if (Model != null && Model.Any())
                {
                    foreach (var cliente in Model)
                    {
                        <tr data-id="@cliente.IdCliente" 
                            data-nombre="@cliente.Nombre @cliente.PrimerApellido @cliente.SegundoApellido"
                            data-cedula="@cliente.NumeroIdentificacion"
                            data-telefono="@cliente.Telefono"
                            data-correo="@cliente.CorreoElectronico">
                            <td>@cliente.IdCliente</td>
                            <td>@cliente.Nombre @cliente.PrimerApellido @cliente.SegundoApellido</td>
                            <td>@cliente.NumeroIdentificacion</td>
                            <td>@cliente.Telefono</td>
                            <td>@cliente.CorreoElectronico</td>
                            <td class="text-center">
                                <button type="button" class="btn btn-success btn-sm btn-seleccionar-cliente-popup" 
                                        data-id="@cliente.IdCliente" 
                                        data-nombre="@cliente.Nombre @cliente.PrimerApellido @cliente.SegundoApellido">
                                    <i class="bi bi-check-circle"></i> Seleccionar
                                </button>
                            </td>
                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="6" class="text-center">No se encontraron clientes.</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>