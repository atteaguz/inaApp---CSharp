@using inaApp.DTOs.Producto
@model List<ProductoResponseDTO>

<div class="modal-header">
    <h5 class="modal-title">Seleccionar Producto</h5>
    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
</div>
<div class="modal-body">
    <div class="mb-3">
        <div class="input-group">
            <span class="input-group-text"><i class="bi bi-search"></i></span>
            <input type="text" id="buscarProductoInput" class="form-control" placeholder="Buscar por ID o nombre del producto..." />
        </div>
    </div>

    <div class="table-responsive">
        <table class="table table-bordered table-striped table-hover">
            <thead class="table-dark">
                <tr>
                    <th>Id</th>
                    <th>Nombre</th>
                    <th>Categoría</th>
                    <th class="text-end">Precio</th>
                    <th class="text-center">Stock</th>
                    <th>Impuesto</th>
                    <th class="text-center">% Descuento Máx</th>
                    <th class="text-center">Cantidad</th>
                    <th class="text-center">Acción</th>
                </tr>
            </thead>
            <tbody id="tablaProductosBody">
                @if (Model != null && Model.Any())
                {
                    foreach (var producto in Model)
                    {
                        <tr data-id="@producto.Id" 
                            data-nombre="@producto.Nombre">
                            <td>@producto.Id</td>
                            <td>@producto.Nombre</td>
                            <td>@producto.CategoriaNombre</td>
                            <td class="text-end">₡@producto.Precio.ToString("N2")</td>
                            <td class="text-center">@producto.Stock</td>
                            <td>@producto.TipoImpuestoNombre (@producto.PorcentajeImpuesto%)</td>
                            <td class="text-center">@producto.DescuentoMaximo%</td>
                            <td class="text-center">
                                <input type="number" class="form-control form-control-sm text-center cantidad-producto" 
                                       data-id="@producto.Id" value="1" min="1" max="@producto.Stock" style="width:80px;display:inline-block;" />
                            </td>
                            <td class="text-center">
                                <button type="button" class="btn btn-success btn-sm btn-agregar-producto-popup" 
                                        data-id="@producto.Id" 
                                        data-nombre="@producto.Nombre" 
                                        data-precio="@producto.Precio.ToString(System.Globalization.CultureInfo.InvariantCulture)" 
                                        data-stock="@producto.Stock" 
                                        data-porcentaje-impuesto="@producto.PorcentajeImpuesto" 
                                        data-descuento-maximo="@producto.DescuentoMaximo">
                                    <i class="bi bi-plus-circle"></i> Agregar
                                </button>
                            </td>
                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="9" class="text-center">No se encontraron productos.</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>