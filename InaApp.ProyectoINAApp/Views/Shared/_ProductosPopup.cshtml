@using inaApp.DTOs.Producto
@model List<ProductoResponseDTO>

<div class="modal-header">
    <h5 class="modal-title">Seleccionar Producto</h5>
    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
</div>
<div class="modal-body">
    <div class="row mb-3">
        <div class="col-md-6">
            <div class="input-group">
                <input type="text" id="buscarProductoInput" class="form-control" placeholder="Buscar por nombre o ID..." value="@ViewBag.Termino" />
                <button class="btn btn-primary" onclick="buscarProductos()">
                    <i class="bi bi-search"></i> Buscar
                </button>
                <button class="btn btn-secondary" onclick="limpiarBusquedaProductos()">
                    <i class="bi bi-arrow-counterclockwise"></i> Limpiar
                </button>
            </div>
        </div>
        <div class="col-md-4">
            <select id="filtroCategoria" class="form-select" onchange="buscarProductos()">
                <option value="0">Todas las categorías</option>
                @if (ViewBag.CategoriasList != null)
                {
                    foreach (var categoria in ViewBag.CategoriasList)
                    {
                        <option value="@categoria.Value" selected="@(categoria.Selected ? "selected" : null)">@categoria.Text</option>
                    }
                }
            </select>
        </div>
        <div class="col-md-2 text-end">
            <span class="badge bg-info">Stock disponible</span>
        </div>
    </div>

    <div class="table-responsive">
        <table class="table table-bordered table-striped table-hover">
            <thead class="table-dark">
                <tr>
                    <th>Id</th>
                    <th>Nombre</th>
                    <th>Categoría</th>
                    <th class="text-end">Precio</th>
                    <th class="text-center">Stock</th>
                    <th>Impuesto</th>
                    <th class="text-center">% Descuento Máx</th>
                    <th class="text-center">Cantidad</th>
                    <th class="text-center">Acción</th>
                </tr>
            </thead>
            <tbody>
                @if (Model != null && Model.Any())
                {
                    foreach (var producto in Model)
                    {
                        <tr>
                            <td>@producto.Id</td>
                            <td>@producto.Nombre</td>
                            <td>@producto.CategoriaNombre</td>
                            <td class="text-end">₡@producto.Precio.ToString("N2")</td>
                            <td class="text-center">@producto.Stock</td>
                            <td>@producto.TipoImpuestoNombre (@producto.PorcentajeImpuesto%)</td>
                            <td class="text-center">@producto.DescuentoMaximo%</td>
                            <td class="text-center">
                                <input type="number" id="cantidad-@producto.Id" class="form-control form-control-sm text-center" value="1" min="1" max="@producto.Stock" style="width:80px;display:inline-block;" />
                            </td>
                            <td class="text-center">
                                <button type="button" class="btn btn-success btn-sm" onclick="seleccionarProducto(@producto.Id, '@producto.Nombre', @producto.Precio.ToString(System.Globalization.CultureInfo.InvariantCulture), @producto.Stock, '@producto.TipoImpuesto', @producto.PorcentajeImpuesto.ToString(System.Globalization.CultureInfo.InvariantCulture), @producto.DescuentoMaximo.ToString(System.Globalization.CultureInfo.InvariantCulture))">
                                    <i class="bi bi-plus-circle"></i> Agregar
                                </button>
                            </td>
                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="9" class="text-center">No se encontraron productos.</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    <!-- paginacion -->
    @if (ViewBag.TotalPages > 1)
    {
        <nav>
            <ul class="pagination justify-content-center">
                @for (int i = 1; i <= ViewBag.TotalPages; i++)
                {
                    <li class="page-item @(i == ViewBag.CurrentPage ? "active" : "")">
                        <a class="page-link" href="#" onclick="cargarPaginaProductos(@i)">@i</a>
                    </li>
                }
            </ul>
        </nav>
    }
</div>

<script>
    let terminoProducto = '@ViewBag.Termino';
    let paginaActualProducto = @ViewBag.CurrentPage;
    let categoriaIdProducto = @ViewBag.CategoriaId;

    function seleccionarProducto(id, nombre, precio, stock, tipoImpuesto, porcentajeImpuesto, descuentoMaximo) {
        var cantidad = document.getElementById('cantidad-' + id).value;

        if (cantidad < 1) {
            alert('La cantidad debe ser mayor a 0');
            return;
        }

        if (cantidad > stock) {
            alert('Stock insuficiente. Disponible: ' + stock);
            return;
        }

        //verificar si el producto ya esta en la lista
        var detalles = window.opener.document.getElementById('Detalles');
        var productosExistentes = window.opener.document.querySelectorAll('input[name$=".ProductoId"]');

        for (var i = 0; i < productosExistentes.length; i++) {
            if (parseInt(productosExistentes[i].value) === id) {
                alert('El producto "' + nombre + '" ya fue agregado');
                return;
            }
        }

        //agregar el producto al detalle en el formulario principal
        window.opener.agregarProductoDetalle(id, nombre, parseInt(cantidad), precio, stock, tipoImpuesto, parseFloat(porcentajeImpuesto), parseFloat(descuentoMaximo));

        //cerrar el modal
        var modal = bootstrap.Modal.getInstance(document.getElementById('productosModal'));
        modal.hide();
    }

    function buscarProductos() {
        var termino = document.getElementById('buscarProductoInput').value;
        var categoria = document.getElementById('filtroCategoria').value;
        cargarPaginaProductos(1, termino, categoria);
    }

    function limpiarBusquedaProductos() {
        document.getElementById('buscarProductoInput').value = '';
        document.getElementById('filtroCategoria').value = '0';
        cargarPaginaProductos(1, '', '0');
    }

    function cargarPaginaProductos(page, termino, categoria) {
        if (!termino) {
            termino = document.getElementById('buscarProductoInput').value || '';
        }
        if (!categoria) {
            categoria = document.getElementById('filtroCategoria').value || '0';
        }

        fetch(`@Url.Action("BuscarProductos", "Factura")?termino=${encodeURIComponent(termino)}&categoriaId=${categoria}&page=${page}`)
            .then(response => response.text())
            .then(html => {
                document.getElementById('productosPopupContent').innerHTML = html;
            })
            .catch(error => {
                console.error('Error:', error);
            });
    }
</script>