@using InaApp.ProyectoINAApp.Models.Producto
@*
    For more information on enabling MVC for empty projects, visit https://go.microsoft.com/fwlink/?LinkID=397860
*@
@model List<ProductoIndexViewModel>


@{
    ViewData["Title"] = "Productos";
}

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h2>Listado de Productos</h2>
        <a asp-action="Create" class="btn btn-primary">
            Crear Producto
        </a>
    </div>
    <table class="table table-bordered table-striped table-hover">
        <thead class="table-dark">
            <tr>
                <th>Id</th>
                <th>Nombre</th>
                <th>Categoría</th>
                <th>Descripción</th>
                <th class="text-end">Precio</th>
                <th class="text-center">Stock</th>
                <th>Tipo Impuesto</th>
                <th class="text-center">% Impuesto</th>
                <th class="text-center">% Descuento Máx</th>
                <th class="text-center">Acciones</th>
            </tr>
        </thead>
        <tbody>
            @if (Model != null && Model.Any())
            {
                foreach (var producto in Model)
                {
                    <tr>
                        <td>@producto.Id</td>
                        <td>@producto.Nombre</td>
                        <td>@producto.CategoriaNombre</td>
                        <td>@producto.Descripcion</td>
                        <td class="text-end">₡@producto.Precio.ToString("N2")</td>
                        <td class="text-center">@producto.Stock</td>
                        <td>@producto.TipoImpuestoNombre</td>
                        <td class="text-center">@producto.PorcentajeImpuesto%</td>
                        <td class="text-center">@producto.DescuentoMaximo%</td>
                        <td class="text-center">
                            <a asp-action="Details" asp-route-id="@producto.Id" class="btn btn-info btn-sm">
                                <i class="bi bi-eye"></i> Detalles
                            </a>
                            <a asp-action="Edit" asp-route-id="@producto.Id" class="btn btn-warning btn-sm">
                                <i class="bi bi-pencil"></i> Modificar
                            </a>
                            <a asp-action="Delete" asp-route-id="@producto.Id" class="btn btn-danger btn-sm">
                                <i class="bi bi-trash"></i> Eliminar
                            </a>
                        </td>
                    </tr>
                }
            }
            else
            {
                <tr>
                    <td colspan="7" class="text-center">
                        No existen productos registrados.
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>