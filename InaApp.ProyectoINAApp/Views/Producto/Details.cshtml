@using InaApp.ProyectoINAApp.Models.Producto


@model ProductoIndexViewModel
@{
    ViewData["Title"] = "Detalles del Producto";
}

<div class="container mt-4">

    <h2>Detalles del Producto</h2>

    <div class="card">
        <div class="card-header bg-light-subtle text-black">
            Vista de detalles del producto
        </div>

        <div class="card-body">
            <p><strong>Id:</strong> @Model.Id</p>
            <p><strong>Nombre:</strong> @Model.Nombre</p>
            <p><strong>Descripción:</strong> @Model.Descripcion</p>
            <p><strong>Precio:</strong> ₡@Model.Precio.ToString("N2")</p>
            <p><strong>Stock:</strong> @Model.Stock</p>
        </div>
    </div>

    <form asp-action="Index" method="post" class="mt-3">
        <input type="hidden" name="id" value="@Model.Id" />

        <a asp-action="Index" class="btn btn-secondary">
            Volver
        </a>
    </form>

</div>