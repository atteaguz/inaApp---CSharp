@using InaApp.ProyectoINAApp.Models.Producto
@using inaApp.Common.Enums


@model ProductoEditViewModel
@{
    ViewData["Title"] = "Modificar Producto";
}

<div class="container mt-4">
    <h2>Modificar Producto</h2>
    <form asp-action="Edit" method="post">
        <input asp-for="Id" type="hidden" />
        <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
        <div class="mb-3">
            <label asp-for="Nombre" class="form-label"></label>
            <input asp-for="Nombre" class="form-control" />
            <span asp-validation-for="Nombre" class="text-danger"></span>
        </div>
        <div class="mb-3">
            <label asp-for="CategoriaId" class="form-label"></label>
            <select asp-for="CategoriaId" class="form-control" asp-items="ViewBag.Categorias">
                <option value="">Seleccione una categoría</option>
            </select>
            <span asp-validation-for="CategoriaId" class="text-danger"></span>
        </div>
        <div class="mb-3">
            <label asp-for="Descripcion" class="form-label"></label>
            <textarea asp-for="Descripcion" class="form-control"></textarea>
            <span asp-validation-for="Descripcion" class="text-danger"></span>
        </div>
        <div class="mb-3">
            <label asp-for="Precio" class="form-label"></label>
            <input asp-for="Precio" class="form-control" />
            <span asp-validation-for="Precio" class="text-danger"></span>
        </div>
        <div class="mb-3">
            <label asp-for="Stock" class="form-label"></label>
            <input asp-for="Stock" class="form-control" />
            <span asp-validation-for="Stock" class="text-danger"></span>
        </div>
        <div class="row">
            <div class="col-md-4">
                <div class="mb-3">
                    <label asp-for="TipoImpuesto" class="form-label"></label>
                    <select asp-for="TipoImpuesto" class="form-control" asp-items="Html.GetEnumSelectList<TipoImpuestoEnum>()">
                        <option value="">Seleccione un tipo de impuesto</option>
                    </select>
                    <span asp-validation-for="TipoImpuesto" class="text-danger"></span>
                </div>
            </div>
            <div class="col-md-4">
                <div class="mb-3">
                    <label asp-for="PorcentajeImpuesto" class="form-label"></label>
                    <div class="input-group">
                        <input asp-for="PorcentajeImpuesto" class="form-control" type="number" step="0.01" min="0" max="100" />
                        <span class="input-group-text">%</span>
                    </div>
                    <span asp-validation-for="PorcentajeImpuesto" class="text-danger"></span>
                </div>
            </div>
            <div class="col-md-4">
                <div class="mb-3">
                    <label asp-for="DescuentoMaximo" class="form-label"></label>
                    <div class="input-group">
                        <input asp-for="DescuentoMaximo" class="form-control" type="number" step="0.01" min="0" max="100" />
                        <span class="input-group-text">%</span>
                    </div>
                    <span asp-validation-for="DescuentoMaximo" class="text-danger"></span>
                </div>
            </div>
        </div>
        
        <button type="submit" class="btn btn-success">
            Guardar cambios
        </button>
        <a asp-action="Index" class="btn btn-secondary">
            Cancelar
        </a>
    </form>
</div>
@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}