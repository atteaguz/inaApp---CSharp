@using InaApp.ProyectoINAApp.Models.Factura

@model FacturaDetailsViewModel

@{
    ViewData["Title"] = $"Anular Factura #{Model.Id}";
}

<div class="container mt-4">
    <div class="card">
        <div class="card-header bg-danger text-white">
            <h3>Confirmar Anulación</h3>
        </div>
        <div class="card-body">
            <div class="alert alert-warning">
                <strong>Advertencia:</strong>
                ¿Está seguro que desea anular la siguiente factura?
                <br />
                <small class="text-muted">Esta acción no se puede deshacer.</small>
            </div>

            <div class="row">
                <div class="col-md-6">
                    <p><strong># Factura:</strong> @Model.Id</p>
                    <p><strong>Fecha:</strong> @Model.Fecha.ToString("dd/MM/yyyy HH:mm")</p>
                    <p><strong>Cliente:</strong> @Model.ClienteNombre</p>
                </div>
                <div class="col-md-6">
                    <p><strong>Subtotal:</strong> ₡@Model.Subtotal.ToString("N2")</p>
                    <p><strong>Descuento:</strong> ₡@Model.Descuento.ToString("N2")</p>
                    <p><strong>Total:</strong> <span class="fw-bold">₡@Model.Total.ToString("N2")</span></p>
                </div>
            </div>

            <hr />

            <div class="d-flex justify-content-between">
                <a asp-action="Details" asp-route-id="@Model.Id" class="btn btn-secondary">
                    <i class="bi bi-arrow-left"></i> Cancelar
                </a>
                <form asp-action="AnularConfirmado" method="post">
                    <input type="hidden" name="id" value="@Model.Id" />
                    <button type="submit" class="btn btn-danger btn-lg">
                        <i class="bi bi-x-circle"></i> Confirmar Anulación
                    </button>
                </form>
            </div>
        </div>
    </div>
</div>