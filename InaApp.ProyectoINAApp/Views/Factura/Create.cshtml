@using InaApp.ProyectoINAApp.Models.Factura

@model FacturaCreateViewModel

@{
    ViewData["Title"] = "Nueva Factura";
}

<div class="container mt-4">
    <h2>Nueva Factura</h2>
    <hr />

    @if (!string.IsNullOrEmpty(Model.Error))
    {
        <div class="alert alert-danger">@Model.Error</div>
    }

    @if (!Model.TieneDetalles)
    {
        <div class="alert alert-warning">Debe agregar al menos un producto</div>
    }

    @if (TempData["Mensaje"] != null)
    {
        <div class="alert alert-success">@TempData["Mensaje"]</div>
    }

    <div class="row">
        <div class="col-md-6">
            <div class="card">
                <div class="card-header bg-primary text-white">
                    <strong>Datos de la Factura</strong>
                </div>
                <div class="card-body">
                    <!-- ✅ UN SOLO FORMULARIO -->
                    <form asp-action="Create" method="post" id="facturaForm">
                        <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                        <div class="mb-3">
                            <label class="form-label">Cliente</label>
                            <div class="input-group">
                                <input type="hidden" id="ClienteId" name="ClienteId" value="@Model.ClienteId" />
                                <span id="clienteSeleccionado" class="form-control" style="background-color: #f8f9fa;">
                                    @if (Model.ClienteId > 0)
                                    {
                                        <span class="badge bg-success">
                                            <i class="bi bi-person-check"></i> @Model.ClientesList.FirstOrDefault(c => c.Value == Model.ClienteId.ToString())?.Text
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="text-muted">Ningún cliente seleccionado</span>
                                    }
                                </span>
                                <button type="button" id="seleccionarClienteBtn" class="btn btn-outline-primary" onclick="abrirPopupClientes()" @(Model.ClienteId > 0 ? "style=display:none;" : "")>
                                    <i class="bi bi-search"></i> Seleccionar Cliente
                                </button>
                                @if (Model.ClienteId > 0)
                                {
                                    <button type="button" class="btn btn-outline-danger" onclick="limpiarCliente()">
                                        <i class="bi bi-x-circle"></i>
                                    </button>
                                }
                            </div>
                            <span asp-validation-for="ClienteId" class="text-danger"></span>
                        </div>

                        <hr />
                        <h5>Agregar Productos</h5>

                        <div class="mb-3">
                            <div class="input-group">
                                <button type="button" class="btn btn-success" onclick="abrirPopupProductos()">
                                    <i class="bi bi-plus-circle"></i> Buscar Producto
                                </button>
                                <span class="form-control bg-light" id="productoSeleccionadoInfo">
                                    <span class="text-muted">Ningún producto seleccionado</span>
                                </span>
                            </div>
                        </div>

                        <!-- Campos ocultos para los detalles -->
                        @for (int i = 0; i < Model.Detalles.Count; i++)
                        {
                            <input type="hidden" name="Detalles[@i].ProductoId" value="@Model.Detalles[i].ProductoId" />
                            <input type="hidden" name="Detalles[@i].ProductoNombre" value="@Model.Detalles[i].ProductoNombre" />
                            <input type="hidden" name="Detalles[@i].Cantidad" value="@Model.Detalles[i].Cantidad" />
                            <input type="hidden" name="Detalles[@i].PrecioUnitario" value="@Model.Detalles[i].PrecioUnitario" />
                            <input type="hidden" name="Detalles[@i].Subtotal" value="@Model.Detalles[i].Subtotal" />
                            <input type="hidden" name="Detalles[@i].PorcentajeImpuesto" value="@Model.Detalles[i].PorcentajeImpuesto" />
                            <input type="hidden" name="Detalles[@i].MontoImpuesto" value="@Model.Detalles[i].MontoImpuesto" />
                            <input type="hidden" name="Detalles[@i].DescuentoAplicado" value="@Model.Detalles[i].DescuentoAplicado" />
                            <input type="hidden" name="Detalles[@i].TotalLinea" value="@Model.Detalles[i].TotalLinea" />
                        }

                        <!-- ✅ BOTÓN DE GUARDAR DENTRO DEL MISMO FORMULARIO -->
                        <div class="mt-3">
                            <button type="button" class="btn btn-success btn-lg" id="btnGuardarFactura">
                                <i class="bi bi-check-circle"></i> Guardar Factura
                            </button>
                            <a asp-action="Index" class="btn btn-secondary">Cancelar</a>
                        </div>
                    </form>
                </div>
            </div>
        </div>

        <div class="col-md-6">
            <div class="card">
                <div class="card-header bg-secondary text-white">
                    <strong>Detalle de la Factura</strong>
                </div>
                <div class="card-body">
                    <!-- ✅ TABLA SIEMPRE VISIBLE -->
                    <div class="table-responsive" id="contenedorTabla">
                        <table class="table table-sm table-bordered" id="detalleTable">
                            <thead class="table-dark">
                                <tr>
                                    <th>Producto</th>
                                    <th class="text-center">Cant</th>
                                    <th class="text-end">Precio</th>
                                    <th class="text-end">Subtotal</th>
                                    <th class="text-end">Descuento</th>
                                    <th class="text-end">Impuesto</th>
                                    <th class="text-end">Total</th>
                                    <th class="text-center">Acción</th>
                                </tr>
                            </thead>
                            <tbody id="detalleBody">
                                @if (Model.TieneDetalles)
                                {
                                    @for (int i = 0; i < Model.Detalles.Count; i++)
                                    {
                                        <tr id="fila-@Model.Detalles[i].ProductoId">
                                            <td>@Model.Detalles[i].ProductoNombre</td>
                                            <td class="text-center">@Model.Detalles[i].Cantidad</td>
                                            <td class="text-end">₡@Model.Detalles[i].PrecioUnitario.ToString("N2")</td>
                                            <td class="text-end">₡@Model.Detalles[i].Subtotal.ToString("N2")</td>
                                            <td class="text-end">₡@Model.Detalles[i].DescuentoAplicado.ToString("N2")</td>
                                            <td class="text-end">₡@Model.Detalles[i].MontoImpuesto.ToString("N2")</td>
                                            <td class="text-end">₡@Model.Detalles[i].TotalLinea.ToString("N2")</td>
                                            <td class="text-center">
                                                <form asp-action="RemoveProduct" method="post" style="display:inline;">
                                                    <input type="hidden" name="productoId" value="@Model.Detalles[i].ProductoId" />
                                                    @for (int j = 0; j < Model.Detalles.Count; j++)
                                                    {
                                                        if (j != i)
                                                        {
                                                            <input type="hidden" name="Detalles[@j].ProductoId" value="@Model.Detalles[j].ProductoId" />
                                                            <input type="hidden" name="Detalles[@j].ProductoNombre" value="@Model.Detalles[j].ProductoNombre" />
                                                            <input type="hidden" name="Detalles[@j].Cantidad" value="@Model.Detalles[j].Cantidad" />
                                                            <input type="hidden" name="Detalles[@j].PrecioUnitario" value="@Model.Detalles[j].PrecioUnitario" />
                                                            <input type="hidden" name="Detalles[@j].Subtotal" value="@Model.Detalles[j].Subtotal" />
                                                            <input type="hidden" name="Detalles[@j].PorcentajeImpuesto" value="@Model.Detalles[j].PorcentajeImpuesto" />
                                                            <input type="hidden" name="Detalles[@j].MontoImpuesto" value="@Model.Detalles[j].MontoImpuesto" />
                                                            <input type="hidden" name="Detalles[@j].DescuentoAplicado" value="@Model.Detalles[j].DescuentoAplicado" />
                                                            <input type="hidden" name="Detalles[@j].TotalLinea" value="@Model.Detalles[j].TotalLinea" />
                                                        }
                                                    }
                                                    <input type="hidden" name="ClienteId" value="@Model.ClienteId" />
                                                    <button type="submit" class="btn btn-danger btn-sm">
                                                        <i class="bi bi-trash"></i>
                                                    </button>
                                                </form>
                                            </td>
                                        </tr>
                                    }
                                }
                            </tbody>
                        </table>
                    </div>

                    <!-- ⚠️ Mensaje de "No hay productos" (se oculta automáticamente) -->
                    @if (!Model.TieneDetalles)
                    {
                        <div id="mensajeSinProductos" class="text-center text-muted py-4">
                            <i class="bi bi-cart-plus" style="font-size: 3rem;"></i>
                            <p class="mt-2">No hay productos agregados.</p>
                            <p><small>Seleccione un producto y cantidad para agregar.</small></p>
                        </div>
                    }

                    <hr />
                    <div class="row">
                        <div class="col-6 text-end fw-bold">Subtotal:</div>
                        <div class="col-6 text-end" id="lblSubtotal">₡@(Model.Subtotal.ToString("N2"))</div>
                    </div>
                    <div class="row">
                        <div class="col-6 text-end fw-bold">Descuento Total:</div>
                        <div class="col-6 text-end text-success" id="lblDescuento">- ₡@(Model.Descuento.ToString("N2"))</div>
                    </div>
                    <div class="row">
                        <div class="col-6 text-end fw-bold">Impuesto Total:</div>
                        <div class="col-6 text-end" id="lblImpuesto">₡@(Model.ImpuestoTotal.ToString("N2"))</div>
                    </div>
                    <div class="row">
                        <div class="col-6 text-end fw-bold fs-5">Total:</div>
                        <div class="col-6 text-end fs-5 fw-bold text-primary" id="lblTotal">₡@(Model.Total.ToString("N2"))</div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- ========== MODALES DE POPUPS ========== -->
<div class="modal fade" id="clientesModal" tabindex="-1">
    <div class="modal-dialog modal-lg">
        <div class="modal-content" id="clientesPopupContent">
            <div class="modal-body text-center py-5">
                <div class="spinner-border text-primary" role="status">
                    <span class="visually-hidden">Cargando...</span>
                </div>
                <p class="mt-2">Cargando clientes...</p>
            </div>
        </div>
    </div>
</div>

<div class="modal fade" id="productosModal" tabindex="-1">
    <div class="modal-dialog modal-xl">
        <div class="modal-content" id="productosPopupContent">
            <div class="modal-body text-center py-5">
                <div class="spinner-border text-primary" role="status">
                    <span class="visually-hidden">Cargando...</span>
                </div>
                <p class="mt-2">Cargando productos...</p>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />

    <script>
        // ============================================================
        // FUNCIONES PARA POPUP DE CLIENTES
        // ============================================================

        window.abrirPopupClientes = function() {
            var modal = new bootstrap.Modal(document.getElementById('clientesModal'));
            modal.show();

            fetch('@Url.Action("BuscarClientes", "Factura")')
                .then(response => response.text())
                .then(html => {
                    document.getElementById('clientesPopupContent').innerHTML = html;
                })
                .catch(error => {
                    console.error('Error:', error);
                });
        };

        window.limpiarCliente = function() {
            document.getElementById('ClienteId').value = '';
            document.getElementById('clienteSeleccionado').innerHTML = '<span class="text-muted">Ningún cliente seleccionado</span>';
            document.getElementById('seleccionarClienteBtn').style.display = '';
        };

        // ============================================================
        // FUNCIONES PARA POPUP DE PRODUCTOS
        // ============================================================

        window.abrirPopupProductos = function() {
            var modal = new bootstrap.Modal(document.getElementById('productosModal'));
            modal.show();

            fetch('@Url.Action("BuscarProductos", "Factura")')
                .then(response => response.text())
                .then(html => {
                    document.getElementById('productosPopupContent').innerHTML = html;
                })
                .catch(error => {
                    console.error('Error:', error);
                });
        };

        // ============================================================
        // FUNCIÓN PARA AGREGAR PRODUCTO AL DETALLE
        // ============================================================

        window.agregarProductoDetalle = function(productoId, nombre, cantidad, precio, stock, porcentajeImpuesto, descuentoMaximo) {
            console.log('✅ agregarProductoDetalle EJECUTADA');
            console.log('📦 Datos:', {
                productoId, nombre, cantidad, precio, stock, porcentajeImpuesto, descuentoMaximo
            });

            // ============================================================
            // 🔢 CÁLCULOS POR PRODUCTO
            // ============================================================

            var subtotal = cantidad * precio;
            var descuentoLinea = subtotal * (descuentoMaximo / 100);
            var subtotalConDescuento = subtotal - descuentoLinea;
            var impuestoLinea = subtotalConDescuento * (porcentajeImpuesto / 100);
            var totalLinea = subtotalConDescuento + impuestoLinea;

            console.log('💰 Cálculos:', {
                subtotal: subtotal,
                descuentoLinea: descuentoLinea,
                subtotalConDescuento: subtotalConDescuento,
                impuestoLinea: impuestoLinea,
                totalLinea: totalLinea
            });

            // ============================================================
            // 📋 AGREGAR A LA TABLA
            // ============================================================

            var form = document.getElementById('facturaForm');
            var tbody = document.getElementById('detalleBody');

            if (!form || !tbody) {
                console.error('❌ Error: No se encontró el formulario o la tabla');
                alert('Error: No se encontró el formulario de la factura');
                return;
            }

            // Verificar duplicado
            var productosExistentes = document.querySelectorAll('input[name$=".ProductoId"]');
            for (var i = 0; i < productosExistentes.length; i++) {
                if (parseInt(productosExistentes[i].value) === productoId) {
                    alert('El producto "' + nombre + '" ya fue agregado');
                    return;
                }
            }

            // Ocultar mensaje de "No hay productos"
            var mensajeSinProductos = document.getElementById('mensajeSinProductos');
            if (mensajeSinProductos) {
                mensajeSinProductos.style.display = 'none';
            }

            // Crear fila
            var row = document.createElement('tr');
            row.id = 'fila-' + productoId;

            row.innerHTML = `
                        <td>${nombre}</td>
                        <td class="text-center">${cantidad}</td>
                        <td class="text-end">₡${precio.toFixed(2)}</td>
                        <td class="text-end">₡${subtotal.toFixed(2)}</td>
                        <td class="text-end">₡${descuentoLinea.toFixed(2)}</td>
                        <td class="text-end">₡${impuestoLinea.toFixed(2)}</td>
                        <td class="text-end">₡${totalLinea.toFixed(2)}</td>
                        <td class="text-center">
                            <button type="button" class="btn btn-danger btn-sm btn-remove-product" data-id="${productoId}">
                                <i class="bi bi-trash"></i>
                            </button>
                        </td>
                    `;

            tbody.appendChild(row);
            console.log('✅ Fila agregada correctamente');

            // ============================================================
            // 📝 AGREGAR CAMPOS OCULTOS AL FORMULARIO
            // ============================================================

            var index = document.querySelectorAll('input[name$=".ProductoId"]').length;

            var hiddenFields = [
                { name: `Detalles[${index}].ProductoId`, value: productoId },
                { name: `Detalles[${index}].ProductoNombre`, value: nombre },
                { name: `Detalles[${index}].Cantidad`, value: cantidad },
                { name: `Detalles[${index}].PrecioUnitario`, value: precio },
                { name: `Detalles[${index}].Subtotal`, value: subtotal },
                { name: `Detalles[${index}].PorcentajeImpuesto`, value: porcentajeImpuesto },
                { name: `Detalles[${index}].MontoImpuesto`, value: impuestoLinea },
                { name: `Detalles[${index}].DescuentoAplicado`, value: descuentoLinea },
                { name: `Detalles[${index}].TotalLinea`, value: totalLinea }
            ];

            hiddenFields.forEach(function(field) {
                var input = document.createElement('input');
                input.type = 'hidden';
                input.name = field.name;
                input.value = field.value;
                form.appendChild(input);
            });

            // ============================================================
            // 📊 ACTUALIZAR TOTALES
            // ============================================================

            actualizarTotales();

            // Mensaje de éxito
            mostrarMensaje(`Producto "${nombre}" agregado correctamente`, 'success');

            var alertWarning = document.querySelector('.alert-warning');
            if (alertWarning) {
                alertWarning.style.display = 'none';
            }

            // ✅ CERRAR EL POPUP DE PRODUCTOS
            var modal = bootstrap.Modal.getInstance(document.getElementById('productosModal'));
            if (modal) {
                modal.hide();
                console.log('✅ Popup de productos cerrado');
            }

            console.log('🎉 PROCESO COMPLETADO EXITOSAMENTE');
        };

        // ============================================================
        // FUNCIÓN PARA ACTUALIZAR TOTALES
        // ============================================================

        window.actualizarTotales = function() {
            var subtotalGeneral = 0;
            var descuentoGeneral = 0;
            var impuestoGeneral = 0;
            var totalGeneral = 0;

            var filas = document.querySelectorAll('#detalleBody tr');
            filas.forEach(function(fila) {
                var celdas = fila.querySelectorAll('td');
                if (celdas.length >= 8) {
                    var subtotalText = celdas[3].textContent.replace('₡', '').replace(',', '').trim();
                    var descuentoText = celdas[4].textContent.replace('₡', '').replace(',', '').trim();
                    var impuestoText = celdas[5].textContent.replace('₡', '').replace(',', '').trim();
                    var totalText = celdas[6].textContent.replace('₡', '').replace(',', '').trim();

                    subtotalGeneral += parseFloat(subtotalText) || 0;
                    descuentoGeneral += parseFloat(descuentoText) || 0;
                    impuestoGeneral += parseFloat(impuestoText) || 0;
                    totalGeneral += parseFloat(totalText) || 0;
                }
            });

            document.getElementById('lblSubtotal').textContent = '₡' + subtotalGeneral.toFixed(2);
            document.getElementById('lblDescuento').textContent = '- ₡' + descuentoGeneral.toFixed(2);
            document.getElementById('lblImpuesto').textContent = '₡' + impuestoGeneral.toFixed(2);
            document.getElementById('lblTotal').textContent = '₡' + totalGeneral.toFixed(2);

            console.log('📊 Totales actualizados:', {
                subtotalGeneral: subtotalGeneral,
                descuentoGeneral: descuentoGeneral,
                impuestoGeneral: impuestoGeneral,
                totalGeneral: totalGeneral
            });
        };

        // ============================================================
        // FUNCIÓN PARA MOSTRAR MENSAJES
        // ============================================================

        window.mostrarMensaje = function(mensaje, tipo) {
            var alertDiv = document.createElement('div');
            alertDiv.className = 'alert alert-' + tipo + ' alert-dismissible fade show';
            alertDiv.role = 'alert';
            alertDiv.innerHTML = `
                        ${mensaje}
                        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                    `;

            var container = document.querySelector('.container.mt-4');
            container.insertBefore(alertDiv, container.firstChild);

            setTimeout(function() {
                alertDiv.remove();
            }, 5000);
        };

        // ============================================================
        // FUNCIÓN PARA SELECCIONAR CLIENTE
        // ============================================================

        window.seleccionarCliente = function(id, nombre) {
            console.log('✅ seleccionarCliente EJECUTADA');
            console.log('📦 Cliente seleccionado:', { id: id, nombre: nombre });

            document.getElementById('ClienteId').value = id;
            document.getElementById('clienteSeleccionado').innerHTML = `<span class="badge bg-success"><i class="bi bi-person-check"></i> ${nombre}</span>`;
            document.getElementById('clienteSeleccionado').style.display = 'block';
            document.getElementById('seleccionarClienteBtn').style.display = 'none';

            var modal = bootstrap.Modal.getInstance(document.getElementById('clientesModal'));
            if (modal) modal.hide();

            mostrarMensaje('Cliente seleccionado correctamente', 'success');
        };

        // ============================================================
        // 🛡️ VALIDACIÓN ANTES DE GUARDAR (CON UN SOLO FORMULARIO)
        // ============================================================

        document.getElementById('btnGuardarFactura')?.addEventListener('click', function(e) {
            console.log('🛡️ Validando antes de guardar...');

            var clienteId = document.getElementById('ClienteId').value;
            console.log('🔍 ClienteId al guardar:', clienteId);

            // Verificar cliente
            if (!clienteId || clienteId === '0' || clienteId === '') {
                alert('⚠️ Debe seleccionar un cliente antes de guardar la factura');
                return;
            }

            // Verificar que haya al menos un producto
            var filas = document.querySelectorAll('#detalleBody tr');
            if (filas.length === 0) {
                alert('⚠️ Debe agregar al menos un producto antes de guardar la factura');
                return;
            }

            console.log('✅ Factura válida para guardar. Enviando...');

            // ✅ Enviar el formulario principal (que ya tiene todos los campos)
            document.getElementById('facturaForm').submit();
        });

        // ============================================================
        // INICIALIZACIÓN
        // ============================================================

        document.addEventListener('DOMContentLoaded', function() {
            if (document.querySelectorAll('#detalleBody tr').length > 0) {
                var alertWarning = document.querySelector('.alert-warning');
                if (alertWarning) {
                    alertWarning.style.display = 'none';
                }
            }
        });

        // ============================================================
        // 🎯 EVENT LISTENER GLOBAL PARA BOTONES DE AGREGAR PRODUCTO
        // ============================================================

        document.addEventListener('click', function(e) {
            var btn = e.target.closest('.btn-agregar-producto-popup');
            if (btn) {
                console.log('🎯 Click en botón de agregar producto');

                var productoId = parseInt(btn.getAttribute('data-id'));
                var nombre = btn.getAttribute('data-nombre');
                var precio = parseFloat(btn.getAttribute('data-precio'));
                var stock = parseInt(btn.getAttribute('data-stock'));
                var porcentajeImpuesto = parseFloat(btn.getAttribute('data-porcentaje-impuesto') || 0);
                var descuentoMaximo = parseFloat(btn.getAttribute('data-descuento-maximo') || 0);

                var row = btn.closest('tr');
                var cantidadInput = row ? row.querySelector('.cantidad-producto') : null;
                var cantidad = cantidadInput ? parseInt(cantidadInput.value) : 1;

                console.log('📦 Datos del producto a agregar:', {
                    productoId: productoId,
                    nombre: nombre,
                    cantidad: cantidad,
                    precio: precio,
                    stock: stock,
                    porcentajeImpuesto: porcentajeImpuesto,
                    descuentoMaximo: descuentoMaximo
                });

                if (cantidad < 1) {
                    alert('La cantidad debe ser mayor a 0');
                    return;
                }

                if (cantidad > stock) {
                    alert('Stock insuficiente. Disponible: ' + stock);
                    return;
                }

                if (typeof window.agregarProductoDetalle === 'function') {
                    window.agregarProductoDetalle(productoId, nombre, cantidad, precio, stock, porcentajeImpuesto, descuentoMaximo);
                } else {
                    console.error('❌ window.agregarProductoDetalle NO está definida');
                    alert('Error: La función agregarProductoDetalle no está disponible');
                }
            }
        });

        console.log('✅ Event listener global para agregar productos registrado');

        // ============================================================
        // 🎯 EVENT LISTENER GLOBAL PARA BOTONES DE SELECCIONAR CLIENTE
        // ============================================================

        document.addEventListener('click', function(e) {
            var btn = e.target.closest('.btn-seleccionar-cliente-popup');
            if (btn) {
                console.log('🎯 Click en botón de seleccionar cliente');

                var id = parseInt(btn.getAttribute('data-id'));
                var nombre = btn.getAttribute('data-nombre');

                console.log('📦 Cliente seleccionado:', { id: id, nombre: nombre });

                if (typeof window.seleccionarCliente === 'function') {
                    window.seleccionarCliente(id, nombre);
                } else {
                    console.error('❌ window.seleccionarCliente NO está definida');
                    alert('Error: La función seleccionarCliente no está disponible');
                }
            }
        });

        console.log('✅ Event listener global para seleccionar clientes registrado');
    </script>
}