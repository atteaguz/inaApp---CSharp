@using InaApp.ProyectoINAApp.Models.Factura

@model NotaCreditoDetailsViewModel

@{
    ViewData["Title"] = $"Nota de Crédito #{Model.Id}";
}

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h2>Nota de Crédito #@Model.Id</h2>
        <div>
            <a asp-action="Index" class="btn btn-secondary">
                <i class="bi bi-arrow-left"></i> Volver
            </a>
            <a asp-controller="Factura" asp-action="Details" asp-route-id="@Model.FacturaOriginalId" class="btn btn-info">
                <i class="bi bi-receipt"></i> Ver Factura Original
            </a>
        </div>
    </div>

    @if (TempData["Mensaje"] != null)
    {
        <div class="alert alert-success">@TempData["Mensaje"]</div>
    }

    <div class="row">
        <div class="col-md-6">
            <div class="card">
                <div class="card-header bg-light">
                    <strong>Información General</strong>
                </div>
                <div class="card-body">
                    <div class="row">
                        <div class="col-4 fw-bold"># Nota:</div>
                        <div class="col-8">@Model.Id</div>
                    </div>
                    <div class="row">
                        <div class="col-4 fw-bold">Fecha:</div>
                        <div class="col-8">@Model.Fecha.ToString("dd/MM/yyyy HH:mm")</div>
                    </div>
                    <div class="row">
                        <div class="col-4 fw-bold">Tipo:</div>
                        <div class="col-8">
                            <span class="badge bg-warning text-dark">@Model.TipoDocumento</span>
                        </div>
                    </div>
                    <div class="row">
                        <div class="col-4 fw-bold">Factura Original:</div>
                        <div class="col-8">#@Model.FacturaOriginalNumero</div>
                    </div>
                    <div class="row">
                        <div class="col-4 fw-bold">Fecha Creación:</div>
                        <div class="col-8">@Model.FechaCreacion.ToString("dd/MM/yyyy HH:mm")</div>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-md-6">
            <div class="card">
                <div class="card-header bg-light">
                    <strong>Información del Cliente</strong>
                </div>
                <div class="card-body">
                    <div class="row">
                        <div class="col-4 fw-bold">Nombre:</div>
                        <div class="col-8">@Model.ClienteNombre</div>
                    </div>
                    <div class="row">
                        <div class="col-4 fw-bold">Cédula:</div>
                        <div class="col-8">@Model.ClienteCedula</div>
                    </div>
                </div>
            </div>

            <div class="card mt-3">
                <div class="card-header bg-light">
                    <strong>Motivo</strong>
                </div>
                <div class="card-body">
                    <p>@Model.Motivo</p>
                </div>
            </div>
        </div>
    </div>

    <div class="card mt-4">
        <div class="card-header bg-light">
            <strong>Detalle de la Nota de Crédito</strong>
        </div>
        <div class="card-body">
            @if (Model.Detalles != null && Model.Detalles.Any())
            {
                <div class="table-responsive">
                    <table class="table table-bordered table-striped">
                        <thead class="table-dark">
                            <tr>
                                <th>Producto</th>
                                <th class="text-center">Cantidad Original</th>
                                <th class="text-center">Cantidad Acreditada</th>
                                <th class="text-end">Precio Unitario</th>
                                <th class="text-end">Subtotal</th>
                                <th class="text-end">Impuesto</th>
                                <th class="text-end">Total</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var detalle in Model.Detalles)
                            {
                                <tr>
                                    <td>@detalle.ProductoNombre</td>
                                    <td class="text-center">@detalle.CantidadOriginal</td>
                                    <td class="text-center">@detalle.Cantidad</td>
                                    <td class="text-end">₡@detalle.PrecioUnitario.ToString("N2")</td>
                                    <td class="text-end">₡@detalle.Subtotal.ToString("N2")</td>
                                    <td class="text-end">₡@detalle.MontoImpuesto.ToString("N2")</td>
                                    <td class="text-end">₡@detalle.TotalLinea.ToString("N2")</td>
                                </tr>
                            }
                        </tbody>
                        <tfoot>
                            <tr>
                                <td colspan="4" class="text-end fw-bold">Subtotal:</td>
                                <td class="text-end">₡@Model.Subtotal.ToString("N2")</td>
                                <td class="text-end"></td>
                                <td class="text-end"></td>
                            </tr>
                            <tr>
                                <td colspan="4" class="text-end fw-bold text-success">Descuento:</td>
                                <td class="text-end text-success">- ₡@Model.Descuento.ToString("N2")</td>
                                <td class="text-end"></td>
                                <td class="text-end"></td>
                            </tr>
                            <tr>
                                <td colspan="4" class="text-end fw-bold">Impuesto Total:</td>
                                <td class="text-end">₡@Model.ImpuestoTotal.ToString("N2")</td>
                                <td class="text-end"></td>
                                <td class="text-end"></td>
                            </tr>
                            <tr>
                                <td colspan="4" class="text-end fw-bold fs-5">Total Acreditado:</td>
                                <td class="text-end fs-5 fw-bold text-primary" colspan="3">₡@Model.Total.ToString("N2")</td>
                            </tr>
                        </tfoot>
                    </table>
                </div>
            }
            else
            {
                <p class="text-center text-muted">No hay productos en esta nota de credito.</p>
            }
        </div>
    </div>

    <div class="mt-3">
        <a asp-action="Index" class="btn btn-secondary">Volver a la lista</a>
    </div>
</div>