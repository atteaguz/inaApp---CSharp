@using InaApp.ProyectoINAApp.Models.Factura

@model NotaCreditoCreateViewModel

@{
    ViewData["Title"] = "Crear Nota de Crédito";
}

<div class="container mt-4">
    <h2>Crear Nota de Crédito</h2>
    <hr />

    @if (!string.IsNullOrEmpty(Model.Error))
    {
        <div class="alert alert-danger">@Model.Error</div>
    }

    <div class="row">
        <div class="col-md-6">
            <div class="card">
                <div class="card-header bg-primary text-white">
                    <strong>Información de la Factura Original</strong>
                </div>
                <div class="card-body">
                    <p><strong>Factura #:</strong> @Model.FacturaOriginalNumero</p>
                    <p><strong>Cliente:</strong> @Model.ClienteNombre</p>
                    <p><strong>Cédula:</strong> @Model.ClienteCedula</p>
                </div>
            </div>

            <div class="card mt-3">
                <div class="card-header bg-warning text-dark">
                    <strong>Motivo de la Nota de Crédito</strong>
                </div>
                <div class="card-body">
                    <form asp-action="Create" method="post" id="notaForm">
                        <input type="hidden" asp-for="FacturaOriginalId" />

                        <div class="mb-3">
                            <label asp-for="Motivo" class="form-label"></label>
                            <textarea asp-for="Motivo" class="form-control" rows="3" placeholder="Describa el motivo de la nota de crédito..."></textarea>
                            <span asp-validation-for="Motivo" class="text-danger"></span>
                            <small class="text-muted">Máximo 1000 caracteres</small>
                        </div>

                        <!-- CAMPOS OCULTOS CON ID -->
                        @for (int i = 0; i < Model.Detalles.Count; i++)
                        {
                            <input type="hidden" id="hiddenSeleccionado_@i" name="Detalles[@i].Seleccionado" value="@(Model.Detalles[i].Seleccionado ? "true" : "false")" />
                            <input type="hidden" id="hiddenCantidad_@i" name="Detalles[@i].CantidadAcreditar" value="@Model.Detalles[i].CantidadAcreditar" />

                            <input type="hidden" name="Detalles[@i].FacturaDetalleOriginalId" value="@Model.Detalles[i].FacturaDetalleOriginalId" />
                            <input type="hidden" name="Detalles[@i].ProductoId" value="@Model.Detalles[i].ProductoId" />
                            <input type="hidden" name="Detalles[@i].ProductoNombre" value="@Model.Detalles[i].ProductoNombre" />
                            <input type="hidden" name="Detalles[@i].CantidadOriginal" value="@Model.Detalles[i].CantidadOriginal" />
                            <input type="hidden" name="Detalles[@i].PrecioUnitario" value="@Model.Detalles[i].PrecioUnitario" />
                            <input type="hidden" name="Detalles[@i].Subtotal" value="@Model.Detalles[i].Subtotal" />
                            <input type="hidden" name="Detalles[@i].PorcentajeImpuesto" value="@Model.Detalles[i].PorcentajeImpuesto" />
                            <input type="hidden" name="Detalles[@i].MontoImpuesto" value="@Model.Detalles[i].MontoImpuesto" />
                            <input type="hidden" name="Detalles[@i].DescuentoAplicado" value="@Model.Detalles[i].DescuentoAplicado" />
                            <input type="hidden" name="Detalles[@i].TotalLinea" value="@Model.Detalles[i].TotalLinea" />
                        }

                        <button type="submit" class="btn btn-success btn-lg mt-3" id="btnCrearNota">
                            <i class="bi bi-check-circle"></i> Crear Nota de Crédito
                        </button>
                        <a asp-action="Index" asp-controller="Factura" class="btn btn-secondary mt-3">Cancelar</a>
                    </form>
                </div>
            </div>
        </div>

        <div class="col-md-6">
            <div class="card">
                <div class="card-header bg-secondary text-white">
                    <strong>Productos a Acreditar</strong>
                </div>
                <div class="card-body">
                    <div class="table-responsive">
                        <table class="table table-sm table-bordered">
                            <thead class="table-dark">
                                <tr>
                                    <th style="width:40px;">
                                        <input type="checkbox" id="seleccionarTodos" checked onchange="toggleTodos()" />
                                    </th>
                                    <th>Producto</th>
                                    <th class="text-center">Original</th>
                                    <th class="text-center">A Acreditar</th>
                                    <th class="text-end">Precio</th>
                                    <th class="text-end">Subtotal</th>
                                </tr>
                            </thead>
                            <tbody>
                                @for (int i = 0; i < Model.Detalles.Count; i++)
                                {
                                    <tr>
                                        <td class="text-center">
                                            <input type="checkbox" class="chk-producto"
                                                   data-index="@i"
                                            @(Model.Detalles[i].Seleccionado ? "checked" : "") />
                                        </td>
                                        <td>@Model.Detalles[i].ProductoNombre</td>
                                        <td class="text-center">@Model.Detalles[i].CantidadOriginal</td>
                                        <td class="text-center">
                                            <input type="number" class="form-control form-control-sm text-center cant-acreditar"
                                                   data-index="@i"
                                                   value="@Model.Detalles[i].CantidadAcreditar"
                                                   min="1" max="@Model.Detalles[i].CantidadOriginal"
                                                   style="width:70px;display:inline-block;" />
                                        </td>
                                        <td class="text-end">₡@Model.Detalles[i].PrecioUnitario.ToString("N2")</td>
                                        <td class="text-end">₡@Model.Detalles[i].Subtotal.ToString("N2")</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />

    <script>
        // FUNCIÓN PARA SELECCIONAR/DESELECCIONAR TODOS
        function toggleTodos() {
            var checked = document.getElementById('seleccionarTodos').checked;
            document.querySelectorAll('.chk-producto').forEach(function(cb) {
                cb.checked = checked;
            });
        }

        // ACTUALIZAR CAMPOS OCULTOS ANTES DE ENVIAR EL FORMULARIO
        document.getElementById('notaForm').addEventListener('submit', function(e) {
            console.log('🛡️ Preparando envío del formulario...');

            var checkboxes = document.querySelectorAll('.chk-producto');
            var cantidades = document.querySelectorAll('.cant-acreditar');

            // Actualizar los campos ocultos por ID
            checkboxes.forEach(function(cb, index) {
                var hiddenSeleccionado = document.getElementById(`hiddenSeleccionado_${index}`);
                if (hiddenSeleccionado) {
                    hiddenSeleccionado.value = cb.checked ? 'true' : 'false';
                    console.log(`  Detalles[${index}].Seleccionado = ${hiddenSeleccionado.value}`);
                } else {
                    console.warn(`No se encontró hiddenSeleccionado_${index}`);
                }
            });

            cantidades.forEach(function(input, index) {
                var hiddenCantidad = document.getElementById(`hiddenCantidad_${index}`);
                if (hiddenCantidad) {
                    hiddenCantidad.value = input.value;
                    console.log(`  Detalles[${index}].CantidadAcreditar = ${hiddenCantidad.value}`);
                } else {
                    console.warn(`No se encontró hiddenCantidad_${index}`);
                }
            });

            // Verificar que hay al menos un producto seleccionado
            var haySeleccionados = false;
            checkboxes.forEach(function(cb) {
                if (cb.checked) haySeleccionados = true;
            });

            if (!haySeleccionados) {
                e.preventDefault();
                alert('Debe seleccionar al menos un producto para acreditar');
                return false;
            }

            console.log('Formulario enviado');
            return true;
        });
    </script>
}