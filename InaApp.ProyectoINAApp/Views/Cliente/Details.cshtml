@using InaApp.ProyectoINAApp.Models.Cliente

@model ClienteIndexViewModel

@{
    ViewData["Title"] = "Detalles del Cliente";
}

<div class="container mt-4">
    <h2>Detalles del Cliente</h2>
    <hr />

    <div class="card">
        <div class="card-header bg-light-subtle text-black">
            <strong>Información del Cliente</strong>
        </div>
        <div class="card-body">
            <p><strong>Id:</strong> @Model.IdCliente</p>
            <p><strong>Nombre Completo:</strong> @Model.Nombre @Model.PrimerApellido @Model.SegundoApellido</p>
            <p><strong>Tipo de Identificación:</strong> @Model.TipoIdentificacion</p>
            <p><strong>Número de Identificación:</strong> @Model.NumeroIdentificacion</p>
            <p><strong>Correo Electrónico:</strong> @Model.CorreoElectronico</p>
            <p><strong>Teléfono:</strong> @Model.Telefono</p>
            <p>
                <strong>Estado:</strong>
                @if (Model.Estado)
                {
                    <span class="badge bg-success">Activo</span>
                }
                else
                {
                    <span class="badge bg-danger">Inactivo</span>
                }
            </p>
            <p><strong>Fecha de Creación:</strong> @Model.FechaCreacion.ToString("dd/MM/yyyy HH:mm")</p>
        </div>
    </div>

    <div class="mt-3">
        <a asp-action="Index" class="btn btn-secondary">
            Volver a la lista
        </a>
    </div>
</div>