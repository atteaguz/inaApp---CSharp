@using InaApp.ProyectoINAApp.Models.Cliente

@model ClienteIndexViewModel

@{
    ViewData["Title"] = "Eliminar Cliente";
}

<div class="container mt-4">
    <h2>Eliminar Cliente</h2>
    <hr />

    <div class="alert alert-warning mt-3">
        <strong>Advertencia:</strong>
        ¿Está seguro que desea eliminar el siguiente cliente?
        <br />
        <small class="text-muted">Esta acción cambiará el estado del cliente a "Inactivo".</small>
    </div>

    <div class="card">
        <div class="card-header bg-danger text-white">
            <strong>Confirmación de eliminación</strong>
        </div>
        <div class="card-body">
            <p><strong>Id:</strong> @Model.IdCliente</p>
            <p><strong>Nombre Completo:</strong> @Model.Nombre @Model.PrimerApellido @Model.SegundoApellido</p>
            <p><strong>Número de Identificación:</strong> @Model.NumeroIdentificacion</p>
            <p><strong>Correo Electrónico:</strong> @Model.CorreoElectronico</p>
            <p><strong>Teléfono:</strong> @Model.Telefono</p>
            <p>
                <strong>Estado:</strong>
                @if (Model.Estado)
                {
                    <span class="badge bg-success">Activo</span>
                }
                else
                {
                    <span class="badge bg-danger">Inactivo</span>
                }
            </p>
        </div>
    </div>

    <form asp-action="DeleteConfirmed" method="post" class="mt-3">
        <input type="hidden" name="id" value="@Model.IdCliente" />

        <button type="submit" class="btn btn-danger">
            Eliminar
        </button>

        <a asp-action="Index" class="btn btn-secondary">
            Cancelar
        </a>
    </form>
</div>